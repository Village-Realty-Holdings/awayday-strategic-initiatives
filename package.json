{
	"name": "awayday-strategic-initiatives",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"lint": "eslint",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"postinstall": "prisma generate",
		"db:generate": "prisma generate",
		"db:migrate:deploy": "prisma migrate deploy",
		"db:migrate:status": "prisma migrate status",
		"db:seed:admin": "tsx prisma/seed-admin.ts",
		"db:set-password": "tsx prisma/set-password.ts",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv --strict-vars=false env.d.ts"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "0.102.0",
		"@neon/config": "^1.8.6",
		"@neon/env": "^1.5.3",
		"@opennextjs/cloudflare": "1.20.9",
		"@prisma/adapter-pg": "7.8.0",
		"@prisma/client": "7.8.0",
		"better-auth": "1.6.25",
		"lucide-react": "1.17.0",
		"next": "16.3.8",
		"pg": "8.21.0",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-qr-code": "2.1.1",
		"resend": "6.12.4"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "4.3.0",
		"@types/node": "24.10.1",
		"@types/pg": "8.20.0",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"dotenv": "17.4.2",
		"eslint": "9.39.2",
		"eslint-config-next": "16.3.8",
		"prisma": "7.10.0",
		"tailwindcss": "4.3.0",
		"tsx": "4.22.4",
		"typescript": "5.9.3",
		"vitest": "4.1.8",
		"wrangler": "4.149.0"
	},
	"allowScripts": {
		"prisma@7.8.0": true,
		"@prisma/engines@7.8.0": true,
		"esbuild@0.25.4": true,
		"esbuild@0.28.2": true,
		"esbuild@0.28.1": true,
		"unrs-resolver@1.12.2": true,
		"workerd@1.20261006.1": true
	}
}
