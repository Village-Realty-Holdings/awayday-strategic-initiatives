/**
 * Wrangler config: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Workers Builds deploys `master` to production. Every other branch builds a
 * Preview with the `previews` block below: staging database, bucket and URL,
 * never production's. The `staging` branch is the staging environment, at
 * https://staging-awayday-strategic-initiatives.tech-dd8.workers.dev.
 *
 * Secrets (never in this file): `npx wrangler secret put <NAME>`
 *   BETTER_AUTH_SECRET, RESEND_API_KEY, ANTHROPIC_API_KEY, AI_BUDGET_ALERT_TO
 *
 * Local dev: Hyperdrive connects to each binding's localConnectionString (the
 * compose.yaml Postgres), unless CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE
 * is set, which takes precedence.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "awayday-strategic-initiatives",
	// Tech@vrobx.com's Account
	"account_id": "dd8b87f7b0a6209f5191b365d1ba3472",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// Run the Worker near Neon rather than near the user: pages make several
	// sequential DB round trips, so each one is shorter.
	"placement": { "mode": "smart" },
	"workers_dev": true,
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			// live-awayday-strategic-initiatives → Neon `production` branch, DIRECT (non-pooler) host.
			"id": "ffc277cab38c490ca1afb2e02c6e52e8",
			// Local Postgres (compose.yaml). Also lets CI deploys run without a build variable.
			"localConnectionString": "postgresql://awayday:password@localhost:5432/awayday_strategic_initiatives"
		}
	],
	"r2_buckets": [
		{
			// attachments/<initiativeId>/… ; imports/ is reserved for FY27 files.
			"binding": "ATTACHMENTS",
			"bucket_name": "live-awayday-strategic-initiatives"
		}
	],
	"vars": {
		"APP_URL": "https://awayday-strategic-initiatives.tech-dd8.workers.dev",
		"BETTER_AUTH_URL": "https://awayday-strategic-initiatives.tech-dd8.workers.dev",
		"EMAIL_FROM": "Awayday <notifications@mail.vacationhr.com>",
		"ANTHROPIC_MODEL": "claude-sonnet-5-5",
		"AI_MONTHLY_BUDGET_USD": "250"
	},
	// Previews (every branch except master). Every binding and var is restated
	// here, pointing at staging, so a preview never reaches production data.
	"previews": {
		"hyperdrive": [
			{
				"binding": "HYPERDRIVE",
				// staging-awayday-strategic-initiatives → Neon `staging` branch, DIRECT (non-pooler) host.
				"id": "16066b525acd4892a360d3c3081b84da",
				"localConnectionString": "postgresql://awayday:password@localhost:5432/awayday_strategic_initiatives"
			}
		],
		"r2_buckets": [
			{
				"binding": "ATTACHMENTS",
				"bucket_name": "staging-awayday-strategic-initiatives"
			}
		],
		"vars": {
			"APP_URL": "https://staging-awayday-strategic-initiatives.tech-dd8.workers.dev",
			"BETTER_AUTH_URL": "https://staging-awayday-strategic-initiatives.tech-dd8.workers.dev",
			"EMAIL_FROM": "Awayday <notifications@mail.vacationhr.com>",
			"ANTHROPIC_MODEL": "claude-sonnet-5-5",
			"AI_MONTHLY_BUDGET_USD": "250"
		}
	}
}
