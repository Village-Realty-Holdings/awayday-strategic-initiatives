# Copy to .env.local. See README "Local development".
# Local Postgres from compose.yaml (`docker compose up -d`)
DIRECT_URL=postgresql://awayday:password@localhost:5432/awayday_strategic_initiatives
DATABASE_URL=postgresql://awayday:password@localhost:5432/awayday_strategic_initiatives
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://awayday:password@localhost:5432/awayday_strategic_initiatives
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Optional Microsoft Entra SSO. All three are required to enable Microsoft login.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Optional email sign-in links and invitations. Use a Resend-verified sender.
RESEND_API_KEY=
EMAIL_FROM=

# Optional AI features and local-only authentication bypass.
ANTHROPIC_API_KEY=
DEV_AUTH_AS=

# Optional AI tuning. ANTHROPIC_MODEL defaults to claude-sonnet-5-5.
# AI_BUDGET_ALERT_TO is a comma-separated list; the admin setting overrides it.
# AI_TELEMETRY=off disables invocation recording (on by default).
ANTHROPIC_MODEL=
AI_MONTHLY_BUDGET_USD=
AI_BUDGET_ALERT_TO=
AI_TELEMETRY=

# Only read by the prisma/ scripts (npm run db:seed:admin / db:set-password).
# ADMIN_PASSWORD is optional; a temporary one is generated when empty.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
PW_EMAIL=
PW_NEW=
